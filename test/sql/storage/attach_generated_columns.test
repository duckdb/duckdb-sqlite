# name: test/sql/storage/attach_generated_columns.test
# description: Test inserting into SQLite tables with generated, INTEGER PRIMARY KEY and DEFAULT columns
# group: [storage]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/attach_generated_columns.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query('s', 'CREATE TABLE generated_columns_test (
    id    INTEGER PRIMARY KEY,
    price INTEGER,
    qty   INTEGER,
    total INTEGER GENERATED ALWAYS AS (price * qty) STORED,
    total_virtual INTEGER GENERATED ALWAYS AS (price * qty * 2) VIRTUAL,
    note  TEXT NOT NULL DEFAULT ''none'')')

statement ok
DETACH s

statement ok
ATTACH '{TEST_DIR}/attach_generated_columns.db' AS s (TYPE SQLITE)

# generated columns are not visible
query II
SELECT column_name, column_default FROM duckdb_columns() WHERE database_name = 's' AND table_name = 'generated_columns_test' ORDER BY column_index
----
id	NULL
price	NULL
qty	NULL
note	'none'

query II
SELECT constraint_type, constraint_column_names FROM duckdb_constraints() WHERE database_name = 's' AND table_name = 'generated_columns_test' ORDER BY constraint_type
----
NOT NULL	[note]
PRIMARY KEY	[id]

# INTEGER PRIMARY KEY and DEFAULT columns not specified
statement ok
INSERT INTO s.generated_columns_test (price, qty) VALUES (5, 4)

# columns specified in a different order
statement ok
INSERT INTO s.generated_columns_test (qty, price, note) VALUES (3, 1, 'reordered')

# all visible columns
statement ok
INSERT INTO s.generated_columns_test VALUES (100, 5, 2, 'all')

# values for generated columns cannot be specified
statement error
INSERT INTO s.generated_columns_test (price, qty, total) VALUES (1, 1, 42)
----
does not have a column with name "total"

statement error
INSERT INTO s.generated_columns_test VALUES (101, 1, 1, 42, 84, 'too many')
----
has 4 columns but 6 values were supplied

# NOT NULL constraint on a column after the generated columns
statement error
INSERT INTO s.generated_columns_test (price, qty, note) VALUES (1, 1, NULL)
----
NOT NULL constraint failed

# insert from a query
statement ok
INSERT INTO s.generated_columns_test (price, qty) SELECT 2, i FROM range(3) t(i)

query IIII
SELECT * FROM s.generated_columns_test ORDER BY id
----
1	5	4	none
2	1	3	reordered
100	5	2	all
101	2	0	none
102	2	1	none
103	2	2	none

# generated values are computed by SQLite
query IIIIII
SELECT id::BIGINT, price::BIGINT, qty::BIGINT, total::BIGINT, total_virtual::BIGINT, note
FROM sqlite_query('s', 'SELECT * FROM generated_columns_test ORDER BY id')
----
1	5	4	20	40	none
2	1	3	3	6	reordered
100	5	2	10	20	all
101	2	0	0	0	none
102	2	1	2	4	none
103	2	2	4	8	none

# table with a generated column created through DuckDB
statement ok
CREATE TABLE s.duckdb_generated_test (a INTEGER, b INTEGER GENERATED ALWAYS AS (a * 2), c INTEGER DEFAULT 7)

statement ok
INSERT INTO s.duckdb_generated_test (a) VALUES (1)

statement ok
INSERT INTO s.duckdb_generated_test VALUES (2, 3)

# an explicit NULL is stored in a DEFAULT column
statement ok
INSERT INTO s.duckdb_generated_test (a, c) VALUES (3, NULL)

query II
SELECT * FROM s.duckdb_generated_test ORDER BY a
----
1	7
2	3
3	NULL

query III
SELECT a::BIGINT, b::BIGINT, c::BIGINT FROM sqlite_query('s', 'SELECT a, b, c FROM duckdb_generated_test ORDER BY a')
----
1	2	7
2	4	3
3	6	NULL
