# name: test/sql/storage/attach_rowid_comparison.test
# description: check for dropped last row with parallel scan of attached SQLite tables if the rowid range is a multiple of 122,880
# group: [storage]

# see https://github.com/duckdb/duckdb-sqlite/issues/240

require sqlite_scanner

statement ok
ATTACH 'sqlite:{TEST_DIR}/attach_rowid_comparison.db' AS s

statement ok
CREATE OR REPLACE TABLE s.tab1 AS FROM range(122879)

query I
SELECT COUNT(*) FROM s.tab1
----
122879

statement ok
CREATE OR REPLACE TABLE s.tab1 AS FROM range(122880)

query I
SELECT COUNT(*) FROM s.tab1
----
122880

statement ok
CREATE OR REPLACE TABLE s.tab1 AS FROM range(122881)

query I
SELECT COUNT(*) FROM s.tab1
----
122881

statement ok
DETACH s
