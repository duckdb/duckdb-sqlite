# name: test/sql/storage/attach_prefix.test
# description: 
# group: [storage]

require sqlite_scanner

statement ok
ATTACH 'sqlite:{TEST_DIR}/attach_replacement.db' AS s

statement ok
CREATE TABLE s.integers(i INTEGER)

statement ok
INSERT INTO s.integers VALUES (42)

statement ok
DETACH s

# attach automatically finds out this is a sqlite file
statement ok
ATTACH '{TEST_DIR}/attach_replacement.db' AS s

query I
SELECT * FROM s.integers
----
42

statement ok
DETACH s

statement ok
ATTACH '{TEST_DIR}/attach_replacement.db' AS s (TYPE sqlite)

query I
SELECT * FROM s.integers
----
42

statement ok
DETACH s
