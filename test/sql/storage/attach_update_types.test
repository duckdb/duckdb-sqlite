# name: test/sql/storage/attach_update_types.test
# description: UPDATE of columns whose values are converted to the types SQLite stores
# group: [storage]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/attach_update_types.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(s, 'CREATE TABLE dates(id INTEGER, dt DATE, ts TIMESTAMP)')

statement ok
INSERT INTO s.dates VALUES (1, DATE '2000-02-29', TIMESTAMP '2000-02-29 12:34:56'), (2, NULL, NULL)

statement ok
UPDATE s.dates SET dt = dt + 1, ts = ts + INTERVAL 1 HOUR WHERE id = 1

statement ok
UPDATE s.dates SET dt = '2020-05-05', ts = DATE '2021-01-01' WHERE id = 2

query III
SELECT * FROM s.dates ORDER BY id
----
1	2000-03-01	2000-02-29 13:34:56
2	2020-05-05	2021-01-01 00:00:00
