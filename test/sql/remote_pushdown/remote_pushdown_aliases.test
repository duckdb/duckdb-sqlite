# name: test/sql/remote_pushdown/remote_pushdown_aliases.test
# description: References to aliases of the select list
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_aliases.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_aliases.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(id INTEGER PRIMARY KEY, i INTEGER, s TEXT, g INTEGER)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (1, 10, ''a'', 1), (2, 20, ''b'', 1), (3, NULL, ''c'', 2), (4, 40, NULL, 2), (5, 50, ''e'', 3), (6, -5, ''f'', NULL), (7, 7, ''g'', 3)')

statement ok
FROM sqlite_query(l, 'CREATE TABLE u(id INTEGER PRIMARY KEY, k INTEGER)')

statement ok
FROM sqlite_query(l, 'INSERT INTO u VALUES (1, 1), (2, 2), (3, 3)')

# the results are the same with and without remote pushdown
foreach db l s

# references to aliases of the select list
query II
SELECT id % 3 AS k, count(*) FROM {db}.t GROUP BY k HAVING k > 0 ORDER BY k
----
1	3
2	2

query I
SELECT count(*) AS c FROM {db}.t GROUP BY g HAVING c > 1 ORDER BY c
----
2
2
2

query II
SELECT g AS x, sum(i) AS total FROM {db}.t GROUP BY x HAVING total > 20 ORDER BY x
----
1	30
2	40
3	57

query II
SELECT i AS x, x + 1 FROM {db}.t ORDER BY id
----
10	11
20	21
NULL	NULL
40	41
50	51
-5	-4
7	8

query IIII
SELECT i AS x, x + 1 AS y, y * 2 AS z, z - x FROM {db}.t ORDER BY id
----
10	11	22	12
20	21	42	22
NULL	NULL	NULL	NULL
40	41	82	42
50	51	102	52
-5	-4	-8	-3
7	8	16	9

query I
SELECT i * 2 AS x FROM {db}.t WHERE x > 30 ORDER BY id
----
40
80
100

query II
SELECT id, i * 2 AS x FROM {db}.t WHERE x > 30 OR x IS NULL ORDER BY id
----
2	40
3	NULL
4	80
5	100

query II
SELECT id, row_number() OVER (ORDER BY i DESC) AS rn FROM {db}.t QUALIFY rn <= 3 ORDER BY id
----
2	3
4	2
5	1

query II
SELECT g AS grp, count(*) AS cnt FROM {db}.t GROUP BY grp ORDER BY grp
----
1	2
2	2
3	2
NULL	1

# a column takes precedence over an alias - except in the HAVING clause and in a GROUP BY of a name
query II
SELECT id AS i, i FROM {db}.t ORDER BY id
----
1	10
2	20
3	NULL
4	40
5	50
6	-5
7	7

query II
SELECT i AS id, id FROM {db}.t ORDER BY 2
----
10	1
20	2
NULL	3
40	4
50	5
-5	6
7	7

query I
SELECT id * 10 AS i FROM {db}.t WHERE i > 20 ORDER BY 1
----
40
50

query II
SELECT id % 3 AS i, count(*) AS c FROM {db}.t GROUP BY 1 HAVING i > 0 ORDER BY c, i
----
2	2
1	3

query II
SELECT g % 2 AS g, count(*) FROM {db}.t GROUP BY g ORDER BY 1
----
0	2
1	2
1	2
NULL	1

query II
SELECT g % 2 AS g, count(*) AS c FROM {db}.t GROUP BY g HAVING g = 1 ORDER BY 1
----
1	2

query II
SELECT i + 1 AS i, i * 2 FROM {db}.t ORDER BY id
----
11	20
21	40
NULL	NULL
41	80
51	100
-4	-10
8	14

# aliases are not resolved within subqueries
query II
SELECT id AS x, (SELECT count(*) FROM {db}.u WHERE u.k <= t.id) FROM {db}.t ORDER BY id
----
1	1
2	2
3	3
4	3
5	3
6	3
7	3

query II
SELECT id AS k, (SELECT max(k) FROM {db}.u WHERE u.id <= t.id) FROM {db}.t ORDER BY id
----
1	1
2	2
3	3
4	3
5	3
6	3
7	3

# aliases in joins
query III
SELECT t.id AS tid, u.k AS uk, tid + uk FROM {db}.t JOIN {db}.u ON t.g = u.k WHERE uk > 1 ORDER BY tid
----
3	2	5
4	2	6
5	3	8
7	3	10

query III
SELECT g, g % 2 AS h, count(*) AS c FROM {db}.t GROUP BY 1, 2 HAVING g = 1 ORDER BY 1
----
1	1	2

query II
SELECT g AS x, max(i) AS g FROM {db}.t GROUP BY 1 HAVING g > 20 ORDER BY 1
----

query II
SELECT g AS x, max(i) AS g FROM {db}.t GROUP BY g HAVING g > 20 ORDER BY 1
----

endloop

# the aliased expressions are written instead of the references
query II
EXPLAIN SELECT id % 3 AS k, count(*) FROM s.t GROUP BY k HAVING k > 0
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*GROUP BY \("id" % 3\) HAVING \(\("id" % 3\) > 0\).*

query II
EXPLAIN SELECT i AS x, x + 1 FROM s.t
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*\("i" \+ 1\) AS "\(x \+ 1\)".*

foreach db l s

# aliases cannot be used within GROUP BY expressions
statement error
SELECT id AS x, count(*) FROM {db}.t GROUP BY x + 1
----
aliases cannot be used as part of an expression in the GROUP BY

endloop

foreach db l s

# a GROUP BY of a name prefers the column
statement error
SELECT id % 3 AS i, count(*) FROM {db}.t GROUP BY i ORDER BY 1
----
must appear in the GROUP BY clause

statement error
SELECT t.g AS k, count(*) FROM {db}.t JOIN {db}.u ON t.g = u.k GROUP BY k ORDER BY 1
----
must appear in the GROUP BY clause

endloop
