# name: test/sql/remote_pushdown/remote_pushdown_results.test
# description: Pushed down queries return the results DuckDB returns: double literals, quantiles, CTE scopes, DISTINCT ON, VALUES, default_collation
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_results.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_results.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(id INTEGER PRIMARY KEY, r REAL, s TEXT, i INTEGER)')

# the doubles are bound (SQLite does not read every double literal exactly on every platform)
statement ok
INSERT INTO l.t VALUES (1, 1e-6, 'a', 1), (2, 0.1, 'B', 2), (3, 2.5, 'c', 3), (4, 1e-300, 'A', 4), (5, 123456.789, 'b', 5), (6, 0.8, 'C', 6), (7, 1.0 / 3, NULL, 7), (8, 2.5e-310, 'd', 8), (9, 1e22, 'D', 9), (10, 0.3, 'e', 10)

statement ok
FROM sqlite_query(l, 'CREATE TABLE u(x INTEGER)')

statement ok
FROM sqlite_query(l, 'INSERT INTO u VALUES (10), (20)')

# the results are the same with and without remote pushdown
foreach db l s

# double literals are read exactly by SQLite
query I
SELECT count(*) FROM {db}.t WHERE r = 1e-6
----
1

query I
SELECT count(*) FROM {db}.t WHERE r = 0.1
----
1

query I
SELECT count(*) FROM {db}.t WHERE r = 1e-300
----
1

query I
SELECT count(*) FROM {db}.t WHERE r = 123456.789
----
1

query I
SELECT count(*) FROM {db}.t WHERE r = 1.0 / 3
----
1

query I
SELECT count(*) FROM {db}.t WHERE r = 2.5e-310
----
1

query I
SELECT count(*) FROM {db}.t WHERE r = 1e22
----
1

query I
SELECT count(*) FROM {db}.t WHERE r IN (0.8, 0.3, 0.1)
----
3

# discrete quantiles are computed like DuckDB computes them
query IIIIIIII
SELECT quantile_disc(i, 0.1), quantile_disc(i, 0.2), quantile_disc(i, 0.3), quantile_disc(i, 0.4), quantile_disc(i, 0.6), quantile_disc(i, 0.7), quantile_disc(i, 0.8), quantile_disc(i, 0.9) FROM {db}.t
----
1	2	3	4	6	7	8	9

query IIIII
SELECT quantile_disc(i, 0.1::DOUBLE), quantile_disc(i, 0.3::DOUBLE), quantile_disc(i, 0.6::DOUBLE), quantile_disc(i, 0.7::DOUBLE), quantile_disc(i, 0.8::DOUBLE) FROM {db}.t
----
1	3	6	7	8

query III
SELECT quantile_disc(i, 0.8), quantile_disc(i, 0.6), quantile_disc(i, 0.2) FROM {db}.t WHERE id <= 5
----
4	3	1

query III
SELECT quantile_cont(i, 0.8), quantile_cont(i, 0.33), median(i) FROM {db}.t
----
8.2	3.97	5.5

# CTEs only shadow the tables where they are visible
query II
SELECT (WITH u AS (SELECT 1 AS x) SELECT x FROM u), (SELECT count(*) FROM {db}.u)
----
1	2

query I
SELECT x FROM {db}.u WHERE x > (WITH u AS (SELECT 15 AS x) SELECT x FROM u) ORDER BY 1
----
20

query I
SELECT count(*) FROM {db}.t WHERE id IN (WITH t AS (SELECT 1 AS id) SELECT id FROM t)
----
1

# DISTINCT ON refers to the aliases of the result columns
query II
SELECT DISTINCT ON (i) id, id % 2 AS i FROM {db}.t ORDER BY id
----
1	1
2	0

query II
SELECT DISTINCT ON (s) id, upper(s) AS s FROM {db}.t ORDER BY id
----
1	A
2	B
3	C
7	NULL
8	D
10	E

query II
SELECT DISTINCT ON (2) id AS i, i % 2 AS k FROM {db}.t ORDER BY 2, 1 DESC
----
10	0
9	1

query II
SELECT DISTINCT ON (k) id AS i, i % 3 AS k FROM {db}.t ORDER BY k, i DESC
----
9	0
10	1
8	2

# the values of a VALUES list are converted to the types of the columns
query I
SELECT count(DISTINCT a) FROM (VALUES (1), (1.0), ('1')) v(a), {db}.t WHERE t.id = 1
----
1

query II
SELECT a, a / 2 FROM (VALUES (1), (2.5)) v(a), {db}.t WHERE t.id = 1 ORDER BY a
----
1.0	0.5
2.5	1.25

query II
SELECT a, typeof(a) FROM (VALUES (true), (2)) v(a), {db}.t WHERE t.id = 1 ORDER BY 1
----
1	INTEGER
2	INTEGER

endloop

# a table referenced by a CTE before the CTE with its name is defined
foreach db l s

statement ok
USE {db}

query II
WITH x AS (SELECT * FROM t), t AS (SELECT 1 AS id) SELECT (SELECT count(*) FROM x), (SELECT count(*) FROM t)
----
10	1

query I
WITH t AS (SELECT * FROM t WHERE id > 2) SELECT count(*) FROM t
----
8

query II
SELECT (WITH t AS (SELECT 1 AS id) SELECT count(*) FROM t), (SELECT count(*) FROM t)
----
1	10

statement ok
USE memory

endloop

# strings are compared with the default collation in DuckDB
statement ok
SET default_collation = 'nocase'

foreach db l s

query I
SELECT count(*) FROM {db}.t WHERE s = 'a'
----
2

query I
SELECT count(DISTINCT s) FROM {db}.t
----
5

endloop

statement error
CREATE TABLE s.t2 AS SELECT * FROM s.t WHERE s = 'a'
----
default_collation is set

statement ok
RESET default_collation

query II
EXPLAIN SELECT count(*) FROM s.t WHERE r = 1e-300
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_double\(.*

query II
EXPLAIN SELECT count(*) FROM s.t WHERE r = 0.1
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*\("r" = 0\.1\).*
