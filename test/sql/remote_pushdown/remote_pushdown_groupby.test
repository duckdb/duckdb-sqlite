# name: test/sql/remote_pushdown/remote_pushdown_groupby.test
# description: Test remote pushdown of GROUP BY into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_groupby.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_groupby.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(i INTEGER, g INTEGER, v TEXT, d DOUBLE, b INTEGER)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (1, 1, ''a'', 1.5, 1), (2, 1, ''b'', 2.5, 0), (3, 2, ''c'', NULL, 1), (4, 2, NULL, 4.0, NULL), (5, 3, ''e'', -1.0, 0), (6, NULL, ''f'', 6.5, 1), (NULL, NULL, NULL, NULL, NULL)')

statement ok
FROM sqlite_query(l, 'CREATE TABLE empty(i INTEGER, v TEXT)')

# the results are the same with and without remote pushdown
foreach db l s

query II
SELECT g, count(*) FROM {db}.t GROUP BY g ORDER BY g
----
1	2
2	2
3	1
NULL	2

query II
SELECT g, count(*) FROM {db}.t GROUP BY 1 ORDER BY 1
----
1	2
2	2
3	1
NULL	2

query II
SELECT g % 2 AS parity, sum(i) FROM {db}.t GROUP BY parity ORDER BY parity
----
0	7
1	8
NULL	6

query II
SELECT g % 2, sum(i) FROM {db}.t GROUP BY g % 2 ORDER BY 1
----
0	7
1	8
NULL	6

query III
SELECT g, v IS NULL, count(*) FROM {db}.t GROUP BY g, v IS NULL ORDER BY 1, 2
----
1	false	2
2	false	1
2	true	1
3	false	1
NULL	false	1
NULL	true	1

query II
SELECT upper(v), count(*) FROM {db}.t GROUP BY upper(v) ORDER BY 1
----
A	1
B	1
C	1
E	1
F	1
NULL	2

query IIII
SELECT g, b, count(*), max(i) FROM {db}.t GROUP BY g, b ORDER BY g, b
----
1	0	1	2
1	1	1	1
2	1	1	3
2	NULL	1	4
3	0	1	5
NULL	1	1	6
NULL	NULL	1	NULL

query I
SELECT g FROM {db}.t GROUP BY g HAVING count(*) > 1 ORDER BY g
----
1
2
NULL

query II
SELECT g, sum(i) FROM {db}.t WHERE i > 1 GROUP BY g HAVING sum(i) > 3 ORDER BY g
----
2	7
3	5
NULL	6

query I
SELECT DISTINCT g FROM {db}.t ORDER BY g
----
1
2
3
NULL

query I
SELECT count(*) FROM (SELECT g FROM {db}.t GROUP BY g)
----
4

query II
SELECT g, count(*) FROM {db}.t GROUP BY g ORDER BY count(*) DESC, g
----
1	2
2	2
NULL	2
3	1

query II
SELECT CASE WHEN i > 3 THEN 'big' ELSE 'small' END AS size, count(*) FROM {db}.t GROUP BY size ORDER BY size
----
big	3
small	4

endloop

query II
EXPLAIN SELECT g % 2 AS parity, sum(i) FROM s.t GROUP BY parity ORDER BY parity
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*GROUP BY \("g" % 2\) ORDER BY "parity" ASC NULLS LAST.*

# GROUP BY ALL, GROUPING SETS, ROLLUP and CUBE are executed locally
query II
EXPLAIN SELECT g, count(*) FROM s.t GROUP BY ALL
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT g, b, count(*) FROM s.t GROUP BY ROLLUP (g, b)
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT g, b, count(*) FROM s.t GROUP BY GROUPING SETS ((g), (b))
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*
