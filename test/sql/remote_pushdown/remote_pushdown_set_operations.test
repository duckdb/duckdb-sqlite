# name: test/sql/remote_pushdown/remote_pushdown_set_operations.test
# description: Test remote pushdown of set operations into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_set_operations.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_set_operations.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE a(i INTEGER, v TEXT, d DATE)')

statement ok
FROM sqlite_query(l, 'CREATE TABLE b(i INTEGER, w TEXT)')

statement ok
FROM sqlite_query(l, 'CREATE TABLE c(j INTEGER, i INTEGER)')

statement ok
FROM sqlite_query(l, 'INSERT INTO a VALUES (1, ''one'', ''2020-01-01''), (2, ''two'', ''2020-02-02''), (3, ''three'', NULL), (NULL, ''null'', ''2020-04-04'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO b VALUES (1, ''uno''), (3, ''tres''), (3, ''drei''), (4, ''cuatro''), (NULL, ''nada'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO c VALUES (10, 1), (20, 4), (30, NULL)')

# the results are the same with and without remote pushdown
foreach db l s

query I
SELECT i FROM {db}.a UNION SELECT i FROM {db}.b ORDER BY 1 NULLS FIRST
----
NULL
1
2
3
4

query I
SELECT i FROM {db}.a UNION ALL SELECT i FROM {db}.b ORDER BY 1 NULLS FIRST
----
NULL
NULL
1
1
2
3
3
3
4

query I
SELECT i FROM {db}.a EXCEPT SELECT i FROM {db}.b ORDER BY 1
----
2

query I
SELECT i FROM {db}.a INTERSECT SELECT i FROM {db}.b ORDER BY 1
----
1
3
NULL

query II
SELECT i, v FROM {db}.a UNION SELECT i, w FROM {db}.b ORDER BY i NULLS LAST, v
----
1	one
1	uno
2	two
3	drei
3	three
3	tres
4	cuatro
NULL	nada
NULL	null

query I
SELECT i AS x FROM {db}.a UNION SELECT j FROM {db}.c ORDER BY x DESC
----
30
20
10
3
2
1
NULL

query I
SELECT i FROM {db}.a UNION SELECT i FROM {db}.b UNION SELECT j FROM {db}.c ORDER BY 1
----
1
2
3
4
10
20
30
NULL

query I
SELECT i FROM {db}.a UNION ALL (SELECT i FROM {db}.b INTERSECT SELECT i FROM {db}.c) ORDER BY 1
----
1
1
2
3
4
NULL
NULL

query I
(SELECT i FROM {db}.a UNION ALL SELECT i FROM {db}.b) INTERSECT SELECT i FROM {db}.c ORDER BY 1
----
1
4
NULL

query I
SELECT i FROM {db}.a EXCEPT (SELECT i FROM {db}.b EXCEPT SELECT i FROM {db}.c) ORDER BY 1
----
1
2
NULL

query I
(SELECT i FROM {db}.a ORDER BY i DESC LIMIT 2) UNION ALL (SELECT i FROM {db}.b ORDER BY i LIMIT 1) ORDER BY 1
----
1
2
3

query I
SELECT count(*) FROM (SELECT i FROM {db}.a UNION SELECT i FROM {db}.b)
----
5

query I
SELECT i FROM {db}.a UNION SELECT i FROM {db}.b ORDER BY 1 LIMIT 2 OFFSET 1
----
2
3

query I
SELECT v FROM {db}.a UNION SELECT 'extra' ORDER BY 1
----
extra
null
one
three
two

query I
SELECT d FROM {db}.a UNION SELECT DATE '2021-01-01' ORDER BY 1
----
2020-01-01
2020-02-02
2020-04-04
2021-01-01
NULL

query I
SELECT i FROM {db}.a UNION SELECT 1.5 ORDER BY 1
----
1.0
1.5
2.0
3.0
NULL

endloop

query II
EXPLAIN SELECT i FROM s.a UNION ALL (SELECT i FROM s.b INTERSECT SELECT i FROM s.c)
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*SELECT "i" FROM "a" UNION ALL SELECT \* FROM \(SELECT "i" FROM "b" INTERSECT SELECT "i" FROM "c"\).*

# EXCEPT ALL, INTERSECT ALL and UNION BY NAME are not supported by SQLite
query II
EXPLAIN SELECT i FROM s.a EXCEPT ALL SELECT i FROM s.b
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT i FROM s.a INTERSECT ALL SELECT i FROM s.b
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT i FROM s.a UNION BY NAME SELECT i FROM s.b
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*
