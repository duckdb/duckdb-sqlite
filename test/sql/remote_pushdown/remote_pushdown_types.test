# name: test/sql/remote_pushdown/remote_pushdown_types.test
# description: Test the conversion of SQLite types in the remote pushdown into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_types.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_types.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(i INTEGER, u, n NUMERIC, dec DECIMAL(10, 2), b BOOLEAN, s STRING, j JSON, r REAL, bl BLOB)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (1, 1, 1, 1.5, 1, ''abc'', ''{"a": 1}'', 1, x''01'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (2, ''text'', 2.5, 2, 0, ''x1'', ''[1, 2]'', 2.5, ''text'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (3, 2.5, 3, 3.25, NULL, ''b'', NULL, -1, 42)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (4, x''ff00'', NULL, NULL, 1, NULL, ''"s"'', NULL, NULL)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (5, NULL, 100, 100, 0, ''a'', ''null'', 0, x'''')')

# the results are the same with and without remote pushdown
foreach db l s

query IIIIIIIII
SELECT i, typeof(u), typeof(n), typeof(dec), typeof(b), typeof(s), typeof(j), typeof(r), typeof(bl) FROM {db}.t WHERE i = 1
----
1	BLOB	DOUBLE	DOUBLE	BIGINT	VARCHAR	VARCHAR	DOUBLE	BLOB

# untyped columns are read as BLOB - values of any storage class are read as their bytes
query II
SELECT i, u FROM {db}.t ORDER BY u NULLS FIRST, i
----
5	NULL
1	1
3	2.5
2	text
4	\xFF\x00

query I
SELECT i FROM {db}.t WHERE u = '\x31'::BLOB ORDER BY i
----
1

query III
SELECT count(DISTINCT u), min(u), max(u) FROM {db}.t
----
4	1	\xFF\x00

# NUMERIC / DECIMAL columns are read as DOUBLE
query IIIIII
SELECT i, n, dec, n / 2, dec * 2, n + dec FROM {db}.t ORDER BY i
----
1	1.0	1.5	0.5	3.0	2.5
2	2.5	2.0	1.25	4.0	4.5
3	3.0	3.25	1.5	6.5	6.25
4	NULL	NULL	NULL	NULL	NULL
5	100.0	100.0	50.0	200.0	200.0

query III
SELECT sum(n), avg(dec), max(n) FROM {db}.t
----
106.5	26.6875	100.0

query I
SELECT i FROM {db}.t WHERE n > 2 ORDER BY i
----
2
3
5

# BOOLEAN columns are read as BIGINT
query IIII
SELECT i, b, b = 1, b + 1 FROM {db}.t ORDER BY i
----
1	1	true	2
2	0	false	1
3	NULL	NULL	NULL
4	1	true	2
5	0	false	1

# columns of other types are read as VARCHAR
query IIIII
SELECT i, s, j, s < 'b', j LIKE '%1%' FROM {db}.t ORDER BY i
----
1	abc	{"a": 1}	true	true
2	x1	[1, 2]	false	true
3	b	NULL	false	NULL
4	NULL	"s"	NULL	false
5	a	null	true	false

query I
SELECT i FROM {db}.t WHERE s = 'x1' OR j = '[1, 2]' ORDER BY i
----
2

query II
SELECT s, count(*) FROM {db}.t GROUP BY s ORDER BY s
----
a	1
abc	1
b	1
x1	1
NULL	1

# BLOB columns
query IIII
SELECT i, bl, octet_length(bl), bl = 'text'::BLOB FROM {db}.t ORDER BY i
----
1	\x01	1	false
2	text	4	true
3	42	2	false
4	NULL	NULL	NULL
5	(empty)	0	false

query IIII
SELECT i, r, r * 2, r IS NULL FROM {db}.t ORDER BY i
----
1	1.0	2.0	false
2	2.5	5.0	false
3	-1.0	-2.0	false
4	NULL	NULL	true
5	0.0	0.0	false

endloop

# columns are read the way the table scan reads them
query II
EXPLAIN SELECT u, s, bl FROM s.t ORDER BY i
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*CAST\("u" AS BLOB\) AS "u".*CAST\("s" AS TEXT\) AS "s".*CAST\("bl" AS BLOB\) AS "bl".*

# with sqlite_all_varchar all columns are read as VARCHAR - also by pushed down queries
statement ok
SET sqlite_all_varchar = true

statement ok
DETACH l

statement ok
DETACH s

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_types.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_types.db' AS s (TYPE SQLITE)

foreach db l s

query IIII
SELECT i, u, n, r FROM {db}.t WHERE i <> 4 ORDER BY i
----
1	1	1	1.0
2	text	2.5	2.5
3	2.5	3	-1.0
5	NULL	100	0.0

query III
SELECT i, n || '!', typeof(n) FROM {db}.t WHERE n > '2' ORDER BY i
----
2	2.5!	VARCHAR
3	3!	VARCHAR

query I
SELECT count(*) FROM {db}.t WHERE i = '1'
----
1

endloop

query II
EXPLAIN SELECT i, n || '!' FROM s.t WHERE n > '2'
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*CAST\("n" AS TEXT\) AS "n".*
