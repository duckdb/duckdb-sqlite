# name: test/sql/remote_pushdown/remote_pushdown_cast.test
# description: Test the translation of casts in the remote pushdown into SQLite
# group: [remote_pushdown]

require sqlite_scanner

require-env SQLITE_INTEGRATION_TESTS

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_cast.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_cast.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(i INTEGER, d DOUBLE, v TEXT, b BLOB, dt DATE, ts TIMESTAMP)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (1, 1.5, ''42'', x''4142'', ''2020-01-01'', ''2020-01-01 10:00:00.5'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (-3, -2.5, '' 7 '', x''00'', ''1999-12-31'', ''1999-12-31 23:59:59'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (0, 3.7, ''abc'', x'''', ''2000-02-29'', ''2000-02-29 00:00:00'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (2, 1e20, ''true'', NULL, NULL, NULL)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (NULL, NULL, NULL, NULL, NULL, NULL)')

# the results are the same with and without remote pushdown
foreach db l s

query IIIIII
SELECT i, i::DOUBLE, i::VARCHAR, i::BOOLEAN, i::SMALLINT, i::TINYINT FROM {db}.t ORDER BY i
----
-3	-3.0	-3	true	-3	-3
0	0.0	0	false	0	0
1	1.0	1	true	1	1
2	2.0	2	true	2	2
NULL	NULL	NULL	NULL	NULL	NULL

query IIII
SELECT d, d::BIGINT, d::INTEGER, d::VARCHAR FROM {db}.t WHERE d < 1e10 ORDER BY d
----
-2.5	-2	-2	-2.5
1.5	2	2	1.5
3.7	4	4	3.7

query II
SELECT d, d::VARCHAR FROM {db}.t ORDER BY d
----
-2.5	-2.5
1.5	1.5
3.7	3.7
1e+20	1e+20
NULL	NULL

query IIIII
SELECT v, TRY_CAST(v AS INTEGER), TRY_CAST(v AS DOUBLE), TRY_CAST(v AS BOOLEAN), TRY_CAST(v AS DATE) FROM {db}.t ORDER BY i
----
 7 	7	7.0	NULL	NULL
abc	NULL	NULL	NULL	NULL
42	42	42.0	NULL	NULL
true	NULL	NULL	true	NULL
NULL	NULL	NULL	NULL	NULL

query IIII
SELECT i, (i > 0)::VARCHAR, (i > 0)::INTEGER, (i > 0)::DOUBLE FROM {db}.t ORDER BY i
----
-3	false	0	0.0
0	false	0	0.0
1	true	1	1.0
2	true	1	1.0
NULL	NULL	NULL	NULL

query III
SELECT i, b::VARCHAR, v::BLOB FROM {db}.t ORDER BY i
----
-3	\x00	 7 
0	(empty)	abc
1	AB	42
2	NULL	true
NULL	NULL	NULL

query IIIIII
SELECT i, dt::VARCHAR, ts::VARCHAR, dt::TIMESTAMP, ts::DATE, CAST(dt AS TIMESTAMP) < ts FROM {db}.t ORDER BY i
----
-3	1999-12-31	1999-12-31 23:59:59	1999-12-31 00:00:00	1999-12-31	true
0	2000-02-29	2000-02-29 00:00:00	2000-02-29 00:00:00	2000-02-29	false
1	2020-01-01	2020-01-01 10:00:00.5	2020-01-01 00:00:00	2020-01-01	true
2	NULL	NULL	NULL	NULL	NULL
NULL	NULL	NULL	NULL	NULL	NULL

query III
SELECT i, (dt::VARCHAR)::DATE, (ts::VARCHAR || '')::TIMESTAMP FROM {db}.t ORDER BY i
----
-3	1999-12-31	1999-12-31 23:59:59
0	2000-02-29	2000-02-29 00:00:00
1	2020-01-01	2020-01-01 10:00:00.5
2	NULL	NULL
NULL	NULL	NULL

query II
SELECT i, CAST(i AS VARCHAR) || '-' || CAST(d AS VARCHAR) FROM {db}.t ORDER BY i
----
-3	-3--2.5
0	0-3.7
1	1-1.5
2	2-1e+20
NULL	NULL

query I
SELECT i FROM {db}.t WHERE v::VARCHAR = '42'
----
1

query I
SELECT i FROM {db}.t WHERE TRY_CAST(v AS INTEGER) > 10
----
1

query I
SELECT sum(TRY_CAST(v AS INTEGER)) FROM {db}.t
----
49

endloop

query II
EXPLAIN SELECT i::DOUBLE, i::VARCHAR, (i > 0)::VARCHAR, dt::TIMESTAMP, ts::DATE FROM s.t
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*CAST\("i" AS DOUBLE\).*CAST\("i" AS TEXT\).*WHEN 1 THEN 'true' WHEN 0 THEN 'false'.*\("dt" \|\| ' 00:00:00'\).*substr\("ts", 1, 10\).*

# other casts use DuckDB's cast semantics
query II
EXPLAIN SELECT d::BIGINT, d::VARCHAR, TRY_CAST(v AS INTEGER) FROM s.t
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_cast\("d", 'DOUBLE', 'BIGINT'\).*duckdb_cast\("d", 'DOUBLE', 'VARCHAR'\).*duckdb_try_cast\("v", 'VARCHAR', 'INTEGER'\).*

# invalid casts raise an error in both
foreach db l s

statement error
SELECT v::INTEGER FROM {db}.t ORDER BY i
----
Could not convert string

statement error
SELECT i::UTINYINT FROM {db}.t ORDER BY i
----
out of range

endloop

# casts to types without a representation in SQLite are executed locally
query II
EXPLAIN SELECT d::DECIMAL(10, 2) FROM s.t
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT d::FLOAT FROM s.t
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT v::INTERVAL FROM s.t
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

# NaN, infinite dates and years outside 1 to 9999 cannot be represented in SQLite - casts in the select list of the
# result return them as their text, which DuckDB reads back
statement ok
FROM sqlite_query(l, 'CREATE TABLE special(i INTEGER, d TEXT, dt TEXT, ts TEXT)')

statement ok
FROM sqlite_query(l, 'INSERT INTO special VALUES (1, ''nan'', ''infinity'', ''infinity''), (2, ''1.5'', ''-infinity'', ''-infinity''), (3, ''inf'', ''10000-01-01'', ''10000-01-01 10:00:00''), (4, ''-inf'', ''0044-03-15 (BC)'', ''0044-03-15 (BC) 10:00:00''), (5, ''2'', ''2020-01-01'', ''2020-01-01 10:00:00'')')

foreach db l s

query IIII
SELECT i, CAST(d AS DOUBLE), CAST(dt AS DATE), TRY_CAST(ts AS TIMESTAMP) FROM {db}.special ORDER BY i
----
1	nan	infinity	infinity
2	1.5	-infinity	-infinity
3	inf	10000-01-01	10000-01-01 10:00:00
4	-inf	0044-03-15 (BC)	0044-03-15 (BC) 10:00:00
5	2.0	2020-01-01	2020-01-01 10:00:00

query I rowsort
SELECT DISTINCT CAST(dt AS DATE) FROM {db}.special
----
-infinity
0044-03-15 (BC)
10000-01-01
2020-01-01
infinity

endloop

query II
EXPLAIN SELECT CAST(d AS DOUBLE), TRY_CAST(dt AS DATE), CAST(ts AS TIMESTAMP), CAST(d AS BIGINT) FROM s.special
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_cast_result\("d", 'VARCHAR', 'DOUBLE'\).*duckdb_try_cast_result\("dt", 'VARCHAR', 'DATE'\).*duckdb_cast_result\("ts", 'VARCHAR', 'TIMESTAMP'\).*duckdb_cast\("d", 'VARCHAR', 'BIGINT'\).*

# elsewhere, SQLite would compare, compute with or store the values - such casts are executed in DuckDB
foreach db l s

query I
SELECT CAST(d AS DOUBLE) AS x FROM {db}.special ORDER BY x
----
-inf
1.5
2.0
inf
nan

query I
SELECT i FROM {db}.special WHERE CAST(dt AS DATE) > DATE '2000-01-01' ORDER BY i
----
1
3
5

query I
SELECT i FROM {db}.special WHERE TRY_CAST(ts AS TIMESTAMP) BETWEEN TIMESTAMP '2000-01-01' AND TIMESTAMP '9999-01-01' ORDER BY i
----
5

query I
SELECT CAST(d AS DOUBLE) + 1 FROM {db}.special ORDER BY i
----
nan
2.5
inf
-inf
3.0

endloop

query II
EXPLAIN SELECT i FROM s.special WHERE CAST(dt AS DATE) > DATE '2000-01-01'
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT CAST(d AS DOUBLE) AS x FROM s.special ORDER BY x
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT CAST(d AS DOUBLE) + 1 FROM s.special
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

# casts of text use the operators of DuckDB's VARCHAR cast
statement ok
FROM sqlite_query(l, 'CREATE TABLE texts(i INTEGER, v TEXT)')

statement ok
FROM sqlite_query(l, 'INSERT INTO texts VALUES (1, '' 42 ''), (2, ''1e2''), (3, ''0x1F''), (4, ''2.5''), (5, ''300''), (6, ''2020-01-01 10:00:00+00''), (7, ''2020-01-01 10:00:00+01''), (8, ''T''), (9, ''''), (10, ''1_000''), (11, NULL)')

foreach db l s

query IIIIIII
SELECT i, TRY_CAST(v AS TINYINT), TRY_CAST(v AS BIGINT), TRY_CAST(v AS DOUBLE), TRY_CAST(v AS BOOLEAN), TRY_CAST(v AS DATE), TRY_CAST(v AS TIMESTAMP) FROM {db}.texts ORDER BY i
----
1	42	42	42.0	NULL	NULL	NULL
2	100	100	100.0	NULL	NULL	NULL
3	31	31	NULL	NULL	NULL	NULL
4	3	3	2.5	NULL	NULL	NULL
5	NULL	300	300.0	NULL	NULL	NULL
6	NULL	NULL	NULL	NULL	2020-01-01	2020-01-01 10:00:00
7	NULL	NULL	NULL	NULL	2020-01-01	2020-01-01 10:00:00
8	NULL	NULL	NULL	true	NULL	NULL
9	NULL	NULL	NULL	NULL	NULL	NULL
10	NULL	1000	1000.0	NULL	NULL	NULL
11	NULL	NULL	NULL	NULL	NULL	NULL

query I
SELECT i FROM {db}.texts WHERE TRY_CAST(v AS BIGINT) > 40 ORDER BY i
----
1
2
5
10

statement error
SELECT CAST(v AS TINYINT) FROM {db}.texts WHERE i = 5
----
Could not convert string '300' to INT8

statement error
SELECT CAST(v AS DATE) FROM {db}.texts WHERE i = 8
----
invalid date field format: "T"

endloop

query II
EXPLAIN SELECT i, TRY_CAST(v AS TINYINT), TRY_CAST(v AS BIGINT), TRY_CAST(v AS DOUBLE), TRY_CAST(v AS BOOLEAN), TRY_CAST(v AS DATE), TRY_CAST(v AS TIMESTAMP) FROM s.texts ORDER BY i
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_try_cast\("v", 'VARCHAR', 'TINYINT'\).*duckdb_try_cast\("v", 'VARCHAR', 'BIGINT'\).*duckdb_try_cast_result\("v", 'VARCHAR', 'DOUBLE'\).*duckdb_try_cast\("v", 'VARCHAR', 'BOOLEAN'\).*duckdb_try_cast_result\("v", 'VARCHAR', 'DATE'\).*duckdb_try_cast_result\("v", 'VARCHAR', 'TIMESTAMP'\).*

query II
EXPLAIN SELECT i FROM s.texts WHERE TRY_CAST(v AS BIGINT) > 40
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_try_cast\("v", 'VARCHAR', 'BIGINT'\).*

statement error
SELECT CAST(v AS TINYINT) FROM s.texts WHERE i = 5
----
Failed to cast value: Could not convert string '300' to INT8

# text that is not valid UTF-8 raises an error, also in TRY_CAST
statement error
SELECT * FROM sqlite_query(s, 'SELECT duckdb_try_cast(CAST(x''FF'' AS TEXT), ''VARCHAR'', ''BIGINT'')')
----
Invalid unicode

# numbers of a VARCHAR source are cast from DuckDB's text of them - SQLite's text of 0.1 + 0.2 is 0.3
query II
SELECT * FROM sqlite_query(s, 'SELECT duckdb_try_cast(0.1 + 0.2, ''VARCHAR'', ''DOUBLE'') = 0.1 + 0.2, duckdb_try_cast(0.1 + 0.2, ''VARCHAR'', ''DOUBLE'') = 0.3')
----
1	0

# the type arguments can change from row to row when the functions are called directly
query I rowsort
SELECT * FROM sqlite_query(s, 'SELECT duckdb_cast(v, t, ''VARCHAR'') FROM (SELECT ''x'' AS v, ''VARCHAR'' AS t UNION ALL SELECT 0, ''DATE'')')
----
1970-01-01
x

query I rowsort
SELECT * FROM sqlite_query(s, 'SELECT duckdb_cast(v, ''VARCHAR'', t) FROM (SELECT ''1'' AS v, ''BIGINT'' AS t UNION ALL SELECT ''2020-01-01'', ''DATE'')')
----
1
2020-01-01
