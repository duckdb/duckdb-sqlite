# name: test/sql/remote_pushdown/remote_pushdown_window.test
# description: Test remote pushdown of window functions into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_window.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_window.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(i INTEGER, g INTEGER, v TEXT, d DOUBLE)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (1, 1, ''a'', 1.5), (2, 1, ''b'', 2.5), (3, 1, ''c'', 2.5), (4, 2, ''d'', NULL), (5, 2, ''e'', -1.0), (6, 3, NULL, 6.5), (7, NULL, ''g'', 0.0)')

# the results are the same with and without remote pushdown
foreach db l s

query IIIII
SELECT i, row_number() OVER (ORDER BY i DESC), rank() OVER (ORDER BY d), dense_rank() OVER (ORDER BY d), rank_dense() OVER (ORDER BY d) FROM {db}.t ORDER BY i
----
1	7	3	3	3
2	6	4	4	4
3	5	4	4	4
4	4	7	6	6
5	3	1	1	1
6	2	6	5	5
7	1	2	2	2

query IIII
SELECT i, percent_rank() OVER (ORDER BY d), cume_dist() OVER (ORDER BY d), ntile(3) OVER (ORDER BY i) FROM {db}.t ORDER BY i
----
1	0.3333333333333333	0.42857142857142855	1
2	0.5	0.7142857142857143	1
3	0.5	0.7142857142857143	1
4	1.0	1.0	2
5	0.0	0.14285714285714285	2
6	0.8333333333333334	0.8571428571428571	3
7	0.16666666666666666	0.2857142857142857	3

query IIII
SELECT i, row_number() OVER (PARTITION BY g ORDER BY i), count(*) OVER (PARTITION BY g), sum(i) OVER (PARTITION BY g ORDER BY i) FROM {db}.t ORDER BY i
----
1	1	3	1
2	2	3	3
3	3	3	6
4	1	2	4
5	2	2	9
6	1	1	6
7	1	1	7

query IIIII
SELECT i, lag(i) OVER (ORDER BY i), lead(i, 2) OVER (ORDER BY i), lag(v, 1, 'none') OVER (ORDER BY i), lead(d, 1, 0) OVER (PARTITION BY g ORDER BY i) FROM {db}.t ORDER BY i
----
1	NULL	3	none	2.5
2	1	4	a	2.5
3	2	5	b	0.0
4	3	6	c	-1.0
5	4	7	d	0.0
6	5	NULL	e	0.0
7	6	NULL	NULL	0.0

query IIII
SELECT i, first_value(v) OVER (PARTITION BY g ORDER BY i), last_value(v) OVER (PARTITION BY g ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING), nth_value(v, 2) OVER (ORDER BY i) FROM {db}.t ORDER BY i
----
1	a	c	NULL
2	a	c	b
3	a	c	b
4	d	e	b
5	d	e	b
6	NULL	NULL	b
7	g	g	b

query IIII
SELECT i, sum(i) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING), avg(d) OVER (ORDER BY i ROWS 2 PRECEDING), min(v) OVER (ORDER BY i ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) FROM {db}.t ORDER BY i
----
1	3	1.5	a
2	6	2.0	b
3	9	2.1666666666666665	c
4	12	2.5	d
5	15	0.75	e
6	18	2.75	g
7	13	1.8333333333333333	g

query III
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN 2 PRECEDING AND CURRENT ROW), count(*) OVER (ORDER BY d RANGE BETWEEN 1.0 PRECEDING AND 1.0 FOLLOWING) FROM {db}.t ORDER BY i
----
1	1	3
2	3	3
3	6	3
4	9	1
5	12	2
6	15	1
7	18	2

query III
SELECT i, count(*) OVER (ORDER BY g GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW), sum(i) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE CURRENT ROW) FROM {db}.t ORDER BY i
----
1	3	NULL
2	3	1
3	3	3
4	5	6
5	5	10
6	3	15
7	2	21

query III
SELECT i, sum(i) OVER (ORDER BY g RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE TIES), sum(i) OVER (ORDER BY g ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE GROUP) FROM {db}.t ORDER BY i
----
1	1	22
2	2	22
3	3	22
4	10	19
5	11	19
6	21	22
7	28	21

query III
SELECT i, sum(i) FILTER (WHERE i % 2 = 1) OVER (ORDER BY i), count(*) FILTER (WHERE d > 0) OVER () FROM {db}.t ORDER BY i
----
1	1	4
2	1	4
3	4	4
4	4	4
5	9	4
6	9	4
7	16	4

query III
SELECT i, string_agg(v, ',') OVER (ORDER BY i), bool_or(d > 2) OVER (ORDER BY i) FROM {db}.t ORDER BY i
----
1	a	false
2	a,b	true
3	a,b,c	true
4	a,b,c,d	true
5	a,b,c,d,e	true
6	a,b,c,d,e	true
7	a,b,c,d,e,g	true

query III
SELECT i, sum(i) OVER w, max(d) OVER w FROM {db}.t WINDOW w AS (PARTITION BY g ORDER BY i) ORDER BY i
----
1	1	1.5
2	3	2.5
3	6	2.5
4	4	NULL
5	9	-1.0
6	6	6.5
7	7	0.0

query III
SELECT i, row_number() OVER (ORDER BY d NULLS FIRST, i), row_number() OVER (ORDER BY v DESC NULLS LAST) FROM {db}.t ORDER BY i
----
1	4	6
2	5	5
3	6	4
4	1	3
5	2	2
6	7	7
7	3	1

query III
SELECT g, sum(i), rank() OVER (ORDER BY sum(i) DESC) FROM {db}.t GROUP BY g ORDER BY g
----
1	6	3
2	9	1
3	6	3
NULL	7	2

query II
SELECT * FROM (SELECT i, row_number() OVER (PARTITION BY g ORDER BY i DESC) AS rn FROM {db}.t) WHERE rn = 1 ORDER BY i
----
3	1
5	1
6	1
7	1

# QUALIFY and DISTINCT ON are a filter over a subquery
query II
SELECT i, g FROM {db}.t QUALIFY row_number() OVER (PARTITION BY g ORDER BY i DESC) = 1 ORDER BY g
----
3	1
5	2
6	3
7	NULL

query III
SELECT i, g, d FROM {db}.t QUALIFY rank() OVER (ORDER BY d DESC NULLS LAST) <= 2 ORDER BY i
----
2	1	2.5
3	1	2.5
6	3	6.5

query II
SELECT g, sum(i) AS s FROM {db}.t GROUP BY g QUALIFY rank() OVER (ORDER BY sum(i) DESC) = 1
----
2	9

query II
SELECT i, g FROM {db}.t QUALIFY count(*) OVER (PARTITION BY g) > 1 ORDER BY i LIMIT 2
----
1	1
2	1

query I
SELECT DISTINCT g FROM {db}.t QUALIFY row_number() OVER (PARTITION BY g ORDER BY i) = 1 ORDER BY g
----
1
2
3
NULL

query III
SELECT DISTINCT ON (g) g, i, v FROM {db}.t ORDER BY g, i DESC
----
1	3	c
2	5	e
3	6	NULL
NULL	7	g

query II
SELECT DISTINCT ON (g) g, i FROM {db}.t ORDER BY g NULLS FIRST, i
----
NULL	7
1	1
2	4
3	6

query III
SELECT DISTINCT ON (g, d > 0) g, d > 0 AS positive, i FROM {db}.t ORDER BY 1, 2, i DESC
----
1	true	3
2	false	5
2	NULL	4
3	true	6
NULL	false	7

endloop

query II
EXPLAIN SELECT i, sum(i) OVER (PARTITION BY g ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM s.t
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*sum\("i"\) OVER \(PARTITION BY "g" ORDER BY "i" ASC NULLS LAST ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING\).*

query II
EXPLAIN SELECT i FROM s.t QUALIFY row_number() OVER (PARTITION BY g ORDER BY i) = 1
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*SELECT "i" FROM \(SELECT "i", \(row_number\(\) OVER \(PARTITION BY "g" ORDER BY "i" ASC NULLS LAST\) = 1\) AS "__qualify" FROM "t"\) WHERE "__qualify".*

query II
EXPLAIN SELECT DISTINCT ON (g) g, i FROM s.t ORDER BY g, i DESC
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*row_number\(\) OVER \(PARTITION BY "g" ORDER BY "g" ASC NULLS LAST, "i" DESC NULLS LAST\) AS "__distinct_on".*WHERE "__distinct_on" = 1.*

# the result columns of a QUALIFY / DISTINCT ON query must be named
query II
EXPLAIN SELECT * FROM s.t QUALIFY row_number() OVER (PARTITION BY g ORDER BY i) = 1
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

# IGNORE NULLS and ordered window arguments are not supported by SQLite

query II
EXPLAIN SELECT i, lag(v IGNORE NULLS) OVER (ORDER BY i) FROM s.t
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

# aggregates that are evaluated with the functions of the extension are not window functions
query II
EXPLAIN SELECT i, median(d) OVER (ORDER BY i) FROM s.t
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*
