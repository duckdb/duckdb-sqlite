# name: test/sql/remote_pushdown/remote_pushdown_identifiers.test
# description: Test identifiers in the remote pushdown into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_identifiers.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_identifiers.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE "My Table"("Weird ""Col""" INTEGER, "select" TEXT, "Ünïcode" DOUBLE, "group" INTEGER, "CamelCase" TEXT)')

statement ok
FROM sqlite_query(l, 'INSERT INTO "My Table" VALUES (1, ''a'', 1.5, 10, ''x''), (2, ''b'', 2.5, 20, ''y''), (3, NULL, NULL, 10, ''z'')')

statement ok
FROM sqlite_query(l, 'CREATE TABLE "order"("from" INTEGER, "autoincrement" INTEGER)')

# the results are the same with and without remote pushdown
foreach db l s

query III
SELECT "Weird ""Col""", "select", "Ünïcode" FROM {db}."My Table" ORDER BY 1
----
1	a	1.5
2	b	2.5
3	NULL	NULL

query III
SELECT "group", count(*), sum("Weird ""Col""") FROM {db}."My Table" GROUP BY "group" ORDER BY "group"
----
10	2	4
20	1	2

query III
SELECT camelcase, CAMELCASE, "CamelCase" FROM {db}."my table" ORDER BY 1
----
x	x	x
y	y	y
z	z	z

query II
SELECT t."select", t."group" + 1 AS "a ""quoted"" alias" FROM {db}."My Table" t WHERE t."select" IS NOT NULL ORDER BY 2
----
a	11
b	21

query I
SELECT "a b".x FROM (SELECT "Weird ""Col""" AS x FROM {db}."My Table") "a b" ORDER BY 1
----
1
2
3

query II
SELECT x."from", x.autoincrement FROM {db}."order" x
----

query IIIII
SELECT * FROM {db}."My Table" ORDER BY 1
----
1	a	1.5	10	x
2	b	2.5	20	y
3	NULL	NULL	10	z

query II
SELECT "group" + 1, "Weird ""Col""" * 2 FROM {db}."My Table" ORDER BY 1, 2
----
11	2
11	6
21	4

query II
SELECT * FROM (SELECT "group" + 1, upper("select") FROM {db}."My Table") ORDER BY 1, 2
----
11	A
11	NULL
21	B

query I
SELECT "(""group"" + 1)" FROM (SELECT "group" + 1 FROM {db}."My Table") ORDER BY 1
----
11
11
21

query II
SELECT x AS "SELECT", y AS "from" FROM (SELECT "group" AS x, "select" AS y FROM {db}."My Table") ORDER BY 1, 2
----
10	a
10	NULL
20	b

endloop

query II
EXPLAIN SELECT "Weird ""Col""", "select" FROM s."My Table" ORDER BY 1
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*SELECT "Weird ""Col""", "select" FROM "My Table" ORDER BY 1 ASC NULLS LAST.*

# the result columns are named the way DuckDB names them
query I
SELECT column_name FROM (DESCRIBE SELECT "group" + 1, count(*), "select" AS s FROM s."My Table" GROUP BY 1, 3)
----
("group" + 1)
count_star()
s
