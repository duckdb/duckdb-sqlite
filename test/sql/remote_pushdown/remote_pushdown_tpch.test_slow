# name: test/sql/remote_pushdown/remote_pushdown_tpch.test_slow
# description: Test the TPC-H queries with remote pushdown into SQLite
# group: [remote_pushdown]

require sqlite_scanner

require-env SQLITE_TPCH_GENERATED

statement ok
ATTACH 'data/db/tpch.db' AS tpch_sqlite (TYPE SQLITE, READ_ONLY);

statement ok
DETACH tpch_sqlite

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH 'data/db/tpch.db' AS tpch_sqlite (TYPE SQLITE, READ_ONLY);

statement ok
USE tpch_sqlite;

require tpch

loop i 1 9

query I
PRAGMA tpch({i})
----
<FILE>:duckdb/extension/tpch/dbgen/answers/sf0.1/q0{i}.csv

endloop

loop i 10 23

query I
PRAGMA tpch({i})
----
<FILE>:duckdb/extension/tpch/dbgen/answers/sf0.1/q{i}.csv

endloop
