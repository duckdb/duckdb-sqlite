# comparisons of integers and doubles
query I
SELECT i FROM {db}.n WHERE i > 1.5 ORDER BY i
----
15
25

query I
SELECT i FROM {db}.n WHERE d >= 2 AND d < 1234.6 ORDER BY i
----
1
15

query I
SELECT i FROM {db}.n WHERE i BETWEEN -7 AND 15 AND d IN (2.5, -2.5, 1234.5678) ORDER BY i
----
-7
1
15

# aggregates
query IIIIIII
SELECT sum(i), round(sum(d), 6), avg(i), round(avg(d), 6), min(d), max(i), count(d) FROM {db}.n
----
19	0.285	3.1666666666666665	0.0475	-1234.5678	25	6

query III
SELECT typeof(sum(i)), typeof(sum(d)), typeof(avg(i)) FROM {db}.n
----
HUGEINT	DOUBLE	DOUBLE

endloop

# the functions are executed in SQLite
query II
EXPLAIN SELECT i / 4, i // 4, i % 4 FROM s.n
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*\(CAST\("i" AS DOUBLE\) / 4\).*\("i" / 4\).*\("i" % 4\).*

query II
EXPLAIN SELECT i / d FROM s.n
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*CASE WHEN "d" = 0 THEN duckdb_divide.*ELSE CAST\("i" AS DOUBLE\) / "d" END.*

query II
EXPLAIN SELECT round(d, 1), round(i, -1), sqrt(d), log(2, d) FROM s.n
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_round\("d", 1, 0\).*duckdb_round_integer\("i", -1, 0\).*duckdb_sqrt\("d"\).*duckdb_log\(2, "d"\).*

# integer division and modulo by zero raise an error, like in DuckDB
foreach db l s

statement error
SELECT i // (i - i) FROM {db}.n
----
Division by zero

statement error
SELECT i % (i - i) FROM {db}.n
----
Division by zero

endloop

# SQLite has no NaN - DuckDB results that are NaN raise an error
query I
SELECT sqrt(d) FROM l.n WHERE d < 0 ORDER BY d
----
nan
nan

statement error
SELECT sqrt(d) FROM s.n WHERE d < 0 ORDER BY d
----
NaN cannot be represented in SQLite

query I
SELECT (i - i) / (i - i) FROM l.n WHERE i = 0
----
nan

statement error
SELECT (i - i) / (i - i) FROM s.n WHERE i = 0
----
NaN cannot be represented in SQLite

# without IEEE semantics, the functions are executed locally
statement ok
SET ieee_floating_point_ops = false

query II
EXPLAIN SELECT sqrt(d) FROM s.n
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

statement ok
RESET ieee_floating_point_ops

# DECIMAL arithmetic is exact in DuckDB - it is only pushed down when the result is a DOUBLE
query II
EXPLAIN SELECT i * 1.5 FROM s.n
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT d * 1.5 FROM s.n
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*\("d" \* 1.5\).*
