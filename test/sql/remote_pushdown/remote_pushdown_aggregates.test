# name: test/sql/remote_pushdown/remote_pushdown_aggregates.test
# description: Test remote pushdown of aggregates into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_aggregates.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_aggregates.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(i INTEGER, g INTEGER, v TEXT, d DOUBLE, b INTEGER)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (1, 1, ''a'', 1.5, 1), (2, 1, ''b'', 2.5, 0), (3, 2, ''c'', NULL, 1), (4, 2, NULL, 4.0, NULL), (5, 3, ''e'', -1.0, 0), (6, NULL, ''f'', 6.5, 1), (NULL, NULL, NULL, NULL, NULL)')

statement ok
FROM sqlite_query(l, 'CREATE TABLE empty(i INTEGER, v TEXT)')

# the results are the same with and without remote pushdown
foreach db l s

query IIIIIIIIIII
SELECT count(*), count(i), count(v), count(DISTINCT g), sum(i), sum(DISTINCT g), avg(d), min(v), max(v), min(d), max(i) FROM {db}.t
----
7	6	5	3	21	6	2.7	a	f	-1.0	6

query IIIIII
SELECT g, count(*), sum(i), avg(d), min(v), max(v) FROM {db}.t GROUP BY g ORDER BY g NULLS FIRST
----
NULL	2	6	6.5	f	f
1	2	3	2.0	a	b
2	2	7	4.0	c	c
3	1	5	-1.0	e	e

query IIIIII
SELECT count(*), sum(i), avg(i), min(v), max(v), string_agg(v, ',') FROM {db}.empty
----
0	NULL	NULL	NULL	NULL	NULL

query II
SELECT g, count(*) FROM {db}.empty JOIN {db}.t USING (i) GROUP BY g
----

# FILTER
query IIIII
SELECT count(*) FILTER (WHERE i > 2), sum(i) FILTER (WHERE g = 1), avg(d) FILTER (WHERE d > 0), count_if(i > 3), countif(v IS NULL) FROM {db}.t
----
4	3	3.625	3	2

query II
SELECT g, count(*) FILTER (WHERE d IS NOT NULL) FROM {db}.t GROUP BY g ORDER BY g
----
1	2
2	1
3	1
NULL	1

# boolean aggregates
query IIII
SELECT bool_and(i > 0), bool_or(i > 5), bool_and(b = 1), bool_or(b = 1) FROM {db}.t
----
true	true	false	true

query III
SELECT g, bool_and(d > 0), bool_or(v = 'c') FROM {db}.t GROUP BY g ORDER BY g
----
1	true	false
2	true	true
3	false	false
NULL	true	false

# string aggregates
query IIII
SELECT g, string_agg(v, ';'), group_concat(v), listagg(v, '-') FROM (SELECT * FROM {db}.t ORDER BY i) GROUP BY g ORDER BY g
----
1	a;b	a,b	a-b
2	c	c	c
3	e	e	e
NULL	f	f	f

query I
SELECT length(string_agg(DISTINCT v, ',')) FROM {db}.t
----
9

# statistics
query IIIIII
SELECT stddev(d), stddev_samp(i), stddev_pop(d), variance(i), var_samp(d), var_pop(i) FROM {db}.t
----
2.797320146139873	1.8708286933869707	2.5019992006393608	3.5	7.825	2.9166666666666665

query III
SELECT g, stddev(d), var_pop(i) FROM {db}.t GROUP BY g ORDER BY g
----
1	0.7071067811865476	0.25
2	NULL	0.25
3	NULL	0.0
NULL	NULL	0.0

query IIIII
SELECT product(i), product(d), bit_and(i), bit_or(i), bit_xor(i) FROM {db}.t
----
720.0	-97.5	0	7	7

query IIIII
SELECT arg_min(v, i), arg_max(v, i), min_by(i, d), max_by(v, d), arg_max(i, v) FROM {db}.t
----
a	f	5	f	6

query IIIIIII
SELECT median(i), median(d), median(v), quantile_cont(d, 0.25), quantile_disc(i, 0.75), quantile(v, 0.1), quantile_cont(i, 0.5) FROM {db}.t
----
3.5	2.5	c	1.5	5	a	3.5

query III
SELECT g, median(d), quantile_disc(v, 0.5) FROM {db}.t GROUP BY g ORDER BY g
----
1	2.0	a
2	4.0	c
3	-1.0	e
NULL	6.5	f

# aggregates of expressions
query IIII
SELECT sum(i * 2), max(i + d), min(length(v)), avg(CASE WHEN i > 2 THEN d ELSE 0 END) FROM {db}.t
----
42	12.5	1	1.5833333333333333

query II
SELECT sum(i) / count(*), max(i) - min(i) FROM {db}.t
----
3.0	5

# HAVING
query II
SELECT g, sum(i) FROM {db}.t GROUP BY g HAVING sum(i) > 3 ORDER BY g
----
2	7
3	5
NULL	6

query II
SELECT g, count(*) AS c FROM {db}.t GROUP BY g HAVING c > 1 ORDER BY g
----
1	2
2	2
NULL	2

query I
SELECT g FROM {db}.t GROUP BY g HAVING max(v) IS NULL OR max(v) > 'b' ORDER BY g
----
2
3
NULL

# aggregates without GROUP BY that filter all rows
query II
SELECT count(*), sum(i) FROM {db}.t WHERE i > 100
----
0	NULL

query I
SELECT sum(i) FROM {db}.t HAVING sum(i) > 100
----

# ordered aggregates
query III
SELECT string_agg(v, '|' ORDER BY i), string_agg(v, '|' ORDER BY i DESC), string_agg(v ORDER BY v) FROM {db}.t
----
a|b|c|e|f	f|e|c|b|a	a,b,c,e,f

query III
SELECT g, string_agg(v, ',' ORDER BY d NULLS FIRST, i DESC), group_concat(i ORDER BY v DESC NULLS LAST, i) FROM {db}.t GROUP BY g ORDER BY g
----
1	a,b	2,1
2	c	3,4
3	e	5
NULL	f	6

query I
SELECT listagg(v, '-' ORDER BY i) FILTER (WHERE i > 2) FROM {db}.t
----
c-e-f

query IIIII
SELECT count(*), min(v ORDER BY i), max(i ORDER BY v), sum(i ORDER BY d), bool_or(i > 3 ORDER BY v) FROM {db}.t
----
7	a	6	21	true

# HAVING without GROUP BY
query I
SELECT count(*) FROM {db}.t HAVING count(*) > 3
----
7

query II
SELECT count(*), max(v) FROM {db}.t WHERE i > 100 HAVING count(*) = 0
----
0	NULL

query I
SELECT sum(i) AS s FROM {db}.t HAVING sum(i) > 100
----

endloop

query II
EXPLAIN SELECT g, count(*) FILTER (WHERE i > 2), count_if(i > 3), bool_and(i > 0) FROM s.t GROUP BY g
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*count\(\*\) FILTER \(WHERE \("i" > 2\)\).*count\(CASE WHEN \("i" > 3\) THEN 1 END\).*min\(\("i" > 0\)\).*GROUP BY "g".*

query II
EXPLAIN SELECT stddev(d), median(d), arg_min(v, i) FROM s.t
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_stddev_samp\("d"\).*duckdb_quantile_cont\("d", 0.5\).*duckdb_arg_min\("v", "i"\).*

# ordered string aggregates are evaluated with duckdb_string_agg (SQLite 3.38 has no ordered aggregates), the ORDER BY
# of aggregates whose result does not depend on the order is skipped
query II
EXPLAIN SELECT string_agg(v, ',' ORDER BY i DESC, d), max(v ORDER BY i) FROM s.t
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_string_agg\("v", ',', 'DLAL', "i", "d"\).*max\("v"\).*

# floating point sums depend on the order of the values
query II
EXPLAIN SELECT sum(d ORDER BY i) FROM s.t
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

# aggregates without an equivalent are executed locally

query II
EXPLAIN SELECT mode(v) FROM s.t
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

query II
EXPLAIN SELECT list(v) FROM s.t
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

# HAVING without GROUP BY requires SQLite 3.39 - it is a filter over the aggregate
query II
EXPLAIN SELECT sum(i) FROM s.t HAVING sum(i) > 100
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*SELECT "sum\(i\)" FROM \(SELECT sum\("i"\) AS "sum\(i\)", \(sum\("i"\) > 100\) AS "__having" FROM "t"\) WHERE "__having".*
