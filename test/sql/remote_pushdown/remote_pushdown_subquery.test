# name: test/sql/remote_pushdown/remote_pushdown_subquery.test
# description: Test remote pushdown of subqueries into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_subquery.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_subquery.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE a(i INTEGER, v TEXT, d DATE)')

statement ok
FROM sqlite_query(l, 'CREATE TABLE b(i INTEGER, w TEXT)')

statement ok
FROM sqlite_query(l, 'CREATE TABLE c(j INTEGER, i INTEGER)')

statement ok
FROM sqlite_query(l, 'INSERT INTO a VALUES (1, ''one'', ''2020-01-01''), (2, ''two'', ''2020-02-02''), (3, ''three'', NULL), (NULL, ''null'', ''2020-04-04'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO b VALUES (1, ''uno''), (3, ''tres''), (3, ''drei''), (4, ''cuatro''), (NULL, ''nada'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO c VALUES (10, 1), (20, 4), (30, NULL)')

statement ok
FROM sqlite_query(l, 'CREATE INDEX b_i ON b(i)')

statement ok
FROM sqlite_query(l, 'CREATE INDEX c_i ON c(i)')

statement ok
FROM sqlite_query(l, 'CREATE TABLE noindex(i INTEGER, w TEXT)')

statement ok
FROM sqlite_query(l, 'INSERT INTO noindex SELECT i, w FROM b')

# the results are the same with and without remote pushdown
foreach db l s

query II
SELECT i, (SELECT max(w) FROM {db}.b WHERE b.i = a.i) FROM {db}.a ORDER BY i
----
1	uno
2	NULL
3	tres
NULL	NULL

query II
SELECT i, (SELECT count(*) FROM {db}.b WHERE b.i > a.i) FROM {db}.a ORDER BY i
----
1	3
2	3
3	1
NULL	0

query II
SELECT i, (SELECT w FROM {db}.b WHERE b.i = a.i AND b.w <> 'drei') FROM {db}.a ORDER BY i
----
1	uno
2	NULL
3	tres
NULL	NULL

query I
SELECT i FROM {db}.a WHERE i IN (SELECT i FROM {db}.b) ORDER BY i
----
1
3

query I
SELECT i FROM {db}.a WHERE i NOT IN (SELECT i FROM {db}.b WHERE i IS NOT NULL) ORDER BY i
----
2

query I
SELECT i FROM {db}.a WHERE i NOT IN (SELECT i FROM {db}.b) ORDER BY i
----

query II
SELECT i, i IN (SELECT i FROM {db}.b) FROM {db}.a ORDER BY i
----
1	true
2	NULL
3	true
NULL	NULL

query I
SELECT i FROM {db}.a WHERE EXISTS (SELECT 1 FROM {db}.b WHERE b.i = a.i) ORDER BY i
----
1
3

query I
SELECT i FROM {db}.a WHERE NOT EXISTS (SELECT * FROM {db}.c WHERE c.i = a.i) ORDER BY i
----
2
3
NULL

query I
SELECT i FROM {db}.a WHERE i = ANY (SELECT i FROM {db}.c) ORDER BY i
----
1

query I
SELECT i FROM {db}.a WHERE i > (SELECT min(i) FROM {db}.b) ORDER BY i
----
2
3

query II
SELECT * FROM (SELECT i, v FROM {db}.a WHERE i > 1) sub ORDER BY i
----
2	two
3	three

query II
SELECT sub.k, count(*) FROM (SELECT i % 2 AS k FROM {db}.a) sub GROUP BY sub.k ORDER BY 1
----
0	1
1	2
NULL	1

query II
SELECT * FROM (SELECT * FROM (SELECT i, w FROM {db}.b) x WHERE x.i > 1) y ORDER BY 1, 2
----
3	drei
3	tres
4	cuatro

query II
SELECT (SELECT i FROM {db}.c ORDER BY j LIMIT 1), (SELECT max(j) FROM {db}.c) FROM {db}.a ORDER BY 1
----
1	30
1	30
1	30
1	30

query I
SELECT i FROM {db}.a WHERE (SELECT count(*) FROM {db}.b WHERE b.i = a.i) > 1
----
3

query II
SELECT i, (SELECT max(j) FROM {db}.c WHERE c.i = a.i) AS m FROM {db}.a WHERE i IS NOT NULL ORDER BY m NULLS FIRST, i
----
2	NULL
3	NULL
1	10

endloop

# DuckDB raises an error when a scalar subquery returns more than one row - SQLite returns the first row
foreach db l s

statement error
SELECT i, (SELECT w FROM {db}.b WHERE b.i = a.i) FROM {db}.a ORDER BY i
----
More than one row returned by a subquery

endloop

query II
EXPLAIN SELECT i, (SELECT w FROM s.b WHERE b.i = a.i) FROM s.a
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_scalar_subquery\("w"\).*LIMIT 2.*

# subqueries that return a single row are written as is
query II
EXPLAIN SELECT i, (SELECT max(w) FROM s.b WHERE b.i = a.i) FROM s.a
----
physical_plan	<!REGEX>:(?s).*duckdb_scalar_subquery.*

statement ok
SET scalar_subquery_error_on_multiple_rows = false

query II
EXPLAIN SELECT i, (SELECT w FROM s.b WHERE b.i = a.i) FROM s.a
----
physical_plan	<!REGEX>:(?s).*duckdb_scalar_subquery.*

statement ok
RESET scalar_subquery_error_on_multiple_rows

# quantified comparisons other than = ANY are executed locally
query I
SELECT i FROM s.a WHERE i > ALL (SELECT i FROM s.c WHERE i IS NOT NULL) ORDER BY i
----

query II
EXPLAIN SELECT i FROM s.a WHERE i > ALL (SELECT i FROM s.c)
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

# SQLite evaluates correlated subqueries for every row - these are only pushed down when the correlated rows can be
# looked up through an index
query II
EXPLAIN SELECT i FROM s.a WHERE EXISTS (SELECT 1 FROM s.b WHERE b.i = a.i)
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*EXISTS \(SELECT 1 AS "1" FROM "b" WHERE \("b"."i" = "a"."i"\)\).*

query I
SELECT i FROM s.a WHERE EXISTS (SELECT 1 FROM s.noindex WHERE noindex.i = a.i) ORDER BY i
----
1
3

query II
EXPLAIN SELECT i FROM s.a WHERE EXISTS (SELECT 1 FROM s.noindex WHERE noindex.i = a.i)
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*

# uncorrelated subqueries are evaluated once
query II
EXPLAIN SELECT i FROM s.a WHERE i IN (SELECT i FROM s.noindex)
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*IN \(SELECT "i" FROM "noindex"\).*
