# name: test/sql/remote_pushdown/remote_pushdown_functions_date.test
# description: Test remote pushdown of date and time functions into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_functions_date.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_functions_date.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(i INTEGER, dt DATE, ts TIMESTAMP, s TEXT)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (1, ''2020-01-31'', ''2020-01-31 10:11:12.123456'', ''2020-01-31'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (2, ''2021-12-31'', ''2021-12-31 23:59:59'', ''2021-12-31 23:59:59'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (3, ''2000-02-29'', ''2000-02-29 00:00:00.5'', ''x'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (4, ''1999-01-03'', 1577836800, ''1999-01-03'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (5, NULL, NULL, NULL)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (6, ''2024-06-30'', ''2024-06-30T12:00:00'', ''2024-06-30 12:00:00'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (7, 1600000000, 1600000000.25, '''')')

# the results are the same with and without remote pushdown
foreach db l s

# dates and timestamps are read like the table scan reads them (ISO strings and unix timestamps)
query III
SELECT i, dt, ts FROM {db}.t ORDER BY i
----
1	2020-01-31	2020-01-31 10:11:12.123456
2	2021-12-31	2021-12-31 23:59:59
3	2000-02-29	2000-02-29 00:00:00.5
4	1999-01-03	2020-01-01 00:00:00
5	NULL	NULL
6	2024-06-30	2024-06-30 12:00:00
7	2020-09-13	2020-09-13 12:26:40.25

query III
SELECT i, typeof(dt), typeof(ts) FROM {db}.t ORDER BY i
----
1	DATE	TIMESTAMP
2	DATE	TIMESTAMP
3	DATE	TIMESTAMP
4	DATE	TIMESTAMP
5	DATE	TIMESTAMP
6	DATE	TIMESTAMP
7	DATE	TIMESTAMP

# comparisons with constants
query I
SELECT i FROM {db}.t WHERE dt > DATE '2000-01-01' ORDER BY i
----
1
2
3
6
7

query I
SELECT i FROM {db}.t WHERE dt >= '2020-01-31' AND dt <= '2021-12-31' ORDER BY i
----
1
2
7

query I
SELECT i FROM {db}.t WHERE ts > TIMESTAMP '2020-01-01 00:00:00' ORDER BY i
----
1
2
6
7

query I
SELECT i FROM {db}.t WHERE ts = TIMESTAMP '2000-02-29 00:00:00.5' ORDER BY i
----
3

query I
SELECT i FROM {db}.t WHERE dt BETWEEN DATE '1999-01-01' AND DATE '2020-12-31' ORDER BY i
----
1
3
4
7

query I
SELECT i FROM {db}.t WHERE dt IN (DATE '2000-02-29', DATE '2024-06-30') ORDER BY i
----
3
6

# comparisons of dates with timestamps
query III
SELECT i, dt < ts, dt = ts::DATE FROM {db}.t ORDER BY i
----
1	true	true
2	true	true
3	true	true
4	true	false
5	NULL	NULL
6	true	true
7	true	true

query I
SELECT i FROM {db}.t WHERE ts > DATE '2020-01-31' ORDER BY i
----
1
2
6
7

# ordering
query II
SELECT i, ts FROM {db}.t ORDER BY ts DESC NULLS LAST, i
