# the date and timestamp columns are converted the way the table scan converts them
query II
EXPLAIN SELECT i FROM s.t WHERE dt > DATE '2000-01-01' ORDER BY i
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_date\("dt"\) AS "dt", "ts" AS "ts".*WHERE \("dt" > '2000-01-01'\).*

# columns that are not used by the query are not converted
query II
EXPLAIN SELECT i FROM s.t WHERE i > 1 ORDER BY i
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*SELECT "i" FROM "t" WHERE \("i" > 1\).*

query II
EXPLAIN SELECT year(dt), date_trunc('month', ts), date_diff('day', dt, ts), dt + 1, ts + INTERVAL 1 DAY FROM s.t
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_date_part\('year', "dt"\).*duckdb_date_trunc\('month', "ts"\).*duckdb_date_diff\('day', "dt", "ts"\).*date\("dt", 1 \|\| ' days'\).*duckdb_add_interval\("ts", 0, 1, 0\).*

# dates beyond the year 9999 cannot be represented in SQLite
query I
SELECT dt + INTERVAL 9000 YEAR FROM l.t WHERE i = 1
----
11020-01-31 00:00:00

statement error
SELECT dt + INTERVAL 9000 YEAR FROM s.t WHERE i = 1
----
cannot be represented in SQLite
