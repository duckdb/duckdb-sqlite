# name: test/sql/remote_pushdown/remote_pushdown_order_nulls.test
# description: Test remote pushdown of ORDER BY / LIMIT and NULL ordering into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_order_nulls.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_order_nulls.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(i INTEGER, v TEXT, d DOUBLE)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (1, ''b'', 2.0), (2, NULL, NULL), (3, ''a'', -1.0), (4, ''B'', 2.0), (5, '''', NULL), (6, ''a'', 10.0)')

# the results are the same with and without remote pushdown
foreach db l s

query II
SELECT i, d FROM {db}.t ORDER BY d, i
----
3	-1.0
1	2.0
4	2.0
6	10.0
2	NULL
5	NULL

query II
SELECT i, d FROM {db}.t ORDER BY d DESC, i
----
6	10.0
1	2.0
4	2.0
3	-1.0
2	NULL
5	NULL

query II
SELECT i, d FROM {db}.t ORDER BY d NULLS FIRST, i
----
2	NULL
5	NULL
3	-1.0
1	2.0
4	2.0
6	10.0

query II
SELECT i, d FROM {db}.t ORDER BY d DESC NULLS LAST, i
----
6	10.0
1	2.0
4	2.0
3	-1.0
2	NULL
5	NULL

query II
SELECT i, v FROM {db}.t ORDER BY v, i
----
5	(empty)
4	B
3	a
6	a
1	b
2	NULL

query II
SELECT i, v FROM {db}.t ORDER BY v DESC NULLS FIRST, i DESC
----
2	NULL
1	b
6	a
3	a
4	B
5	(empty)

query III
SELECT i, v, d FROM {db}.t ORDER BY 3, 2, 1
----
3	a	-1.0
4	B	2.0
1	b	2.0
6	a	10.0
5	(empty)	NULL
2	NULL	NULL

query II
SELECT i, d * 2 AS x FROM {db}.t ORDER BY x, i
----
3	-2.0
1	4.0
4	4.0
6	20.0
2	NULL
5	NULL

query II
SELECT i, d FROM {db}.t ORDER BY d + i, i
----
3	-1.0
1	2.0
4	2.0
6	10.0
2	NULL
5	NULL

query II
SELECT i, v FROM {db}.t ORDER BY length(v) DESC, v, i
----
4	B
3	a
6	a
1	b
5	(empty)
2	NULL

query I
SELECT i FROM {db}.t ORDER BY ALL
----
1
2
3
4
5
6

query II
SELECT v, i FROM {db}.t ORDER BY ALL DESC
----
b	1
a	6
a	3
B	4
(empty)	5
NULL	2

query I
SELECT DISTINCT v FROM {db}.t ORDER BY v NULLS FIRST
----
NULL
(empty)
B
a
b

query II
SELECT v, count(*) FROM {db}.t GROUP BY v ORDER BY v
----
(empty)	1
B	1
a	2
b	1
NULL	1

query I
SELECT i FROM {db}.t ORDER BY i LIMIT 2
----
1
2

query I
SELECT i FROM {db}.t ORDER BY i LIMIT 2 OFFSET 3
----
4
5

query I
SELECT i FROM {db}.t ORDER BY i OFFSET 4
----
5
6

query I
SELECT i FROM {db}.t ORDER BY i LIMIT 0
----

query II
SELECT i, v FROM {db}.t ORDER BY v COLLATE NOCASE, i
----
5	(empty)
3	a
6	a
1	b
4	B
2	NULL

endloop

# NULLs are sorted last by default in DuckDB, first by default in SQLite
query II
EXPLAIN SELECT i, d FROM s.t ORDER BY d, i
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*ORDER BY "d" ASC NULLS LAST, "i" ASC NULLS LAST.*

query II
EXPLAIN SELECT i FROM s.t ORDER BY i OFFSET 4
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*LIMIT -1 OFFSET 4.*

# the default order follows the settings
statement ok
SET default_null_order = 'nulls_first'

query I
SELECT i FROM s.t ORDER BY d, i
----
2
5
3
1
4
6

query II
EXPLAIN SELECT i, d FROM s.t ORDER BY d, i
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*ORDER BY "d" ASC NULLS FIRST, "i" ASC NULLS FIRST.*

statement ok
SET default_order = 'desc'

query I
SELECT i FROM s.t ORDER BY d, i
----
5
2
6
4
1
3

statement ok
RESET default_null_order

statement ok
RESET default_order

# DuckDB collations are not supported by SQLite
query II
EXPLAIN SELECT i, v FROM s.t ORDER BY v COLLATE NOCASE, i
----
physical_plan	<!REGEX>:(?s).*Sqlite Query.*
