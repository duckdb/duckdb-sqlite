# strings are compared byte-wise, also for columns with a collation in SQLite
query I
SELECT i FROM {db}.t WHERE nc = 'hello' ORDER BY i
----
2

query I
SELECT i FROM {db}.t WHERE nc < 'b' ORDER BY i
----
1
3
6
7

