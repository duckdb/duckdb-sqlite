3	(empty)	(empty)	(empty)	(empty)
4	(empty)	(empty)	(empty)	(empty)
5	NULL	NULL	NULL	NULL
6	(empty)	t	(empty)	(empty)
7	(empty)	a	(empty)	(empty)

