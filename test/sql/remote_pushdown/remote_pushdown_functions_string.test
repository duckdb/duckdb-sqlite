# LIKE is case sensitive and has no default escape character
query I
SELECT i FROM {db}.t WHERE s LIKE 'H%' ORDER BY i
----
1

query I
SELECT i FROM {db}.t WHERE s LIKE 'h%' ORDER BY i
----

query I
SELECT i FROM {db}.t WHERE s LIKE '%ß%' ORDER BY i
----
2

query I
SELECT i FROM {db}.t WHERE s LIKE 'a_b%' ORDER BY i
----
3

query I
SELECT i FROM {db}.t WHERE s LIKE '%*%' OR s LIKE '%?%' OR s LIKE '%[%' ORDER BY i
----
3

query I
SELECT i FROM {db}.t WHERE s LIKE 'a\_b%' ESCAPE '\' ORDER BY i
----
3

query I
SELECT i FROM {db}.t WHERE s LIKE 'a$_b$%c%' ESCAPE '$' ORDER BY i
----
3

query I
SELECT i FROM {db}.t WHERE s NOT LIKE '%l%' ORDER BY i
----
2
3
4
6
7

query III
SELECT i, s LIKE p, s NOT LIKE p FROM {db}.t ORDER BY i
----
1	true	false
2	false	true
3	false	true
4	true	false
5	NULL	NULL
6	true	false
7	true	false

query I
SELECT i FROM {db}.t WHERE s ILIKE 'hello%' ORDER BY i
----
1

query I
SELECT i FROM {db}.t WHERE s ILIKE '%STRASSE%' OR s ILIKE '%äé' ORDER BY i
