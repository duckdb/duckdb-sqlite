# padding / reversing (by grapheme clusters)
query IIIIII
SELECT i, lpad(s, 8, '*'), rpad(s, 3, '-'), lpad(s, i::INTEGER, 'ab'), rpad(s, -1, 'x'), lpad(s, 12, 'é') FROM {db}.t ORDER BY i
----
1	Hello Wo	Hel	H	(empty)	éHello World
2	straße Ä	str	st	(empty)	éééstraße ÄÉ
3	a_b%c*d?	a_b	a_b	(empty)	a_b%c*d?e[f]
4	********	---	abab	(empty)	éééééééééééé
5	NULL	NULL	NULL	NULL	NULL
6	it's "qu	it'	it's "	(empty)	it's "quoted
7	  padded	  p	  padde	(empty)	éé  padded  

