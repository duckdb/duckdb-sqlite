# name: test/sql/remote_pushdown/remote_pushdown_functions_string.test
# description: Test remote pushdown of string functions into SQLite
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_functions_string.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_functions_string.db' AS s (TYPE SQLITE)

statement ok
FROM sqlite_query(l, 'CREATE TABLE t(i INTEGER, s TEXT, nc TEXT COLLATE NOCASE, p TEXT)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (1, ''Hello World'', ''Hello'', ''H%'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (2, ''straße ÄÉ'', ''hello'', ''%e'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (3, ''a_b%c*d?e[f]'', ''HELLO'', ''a\_%'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (4, '''', ''b'', '''')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (5, NULL, NULL, NULL)')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (6, ''it''''s "quoted"'', ''Ab'', ''_t%'')')

statement ok
FROM sqlite_query(l, 'INSERT INTO t VALUES (7, ''  padded  '', ''aB'', ''%'')')

# the results are the same with and without remote pushdown
foreach db l s

# concatenation
query IIIII
SELECT i, s || '!', i || s, concat(s, i, '-'), concat_ws(', ', s, i, NULL, 'x') FROM {db}.t ORDER BY i
----
1	Hello World!	1Hello World	Hello World1-	Hello World, 1, x
2	straße ÄÉ!	2straße ÄÉ	straße ÄÉ2-	straße ÄÉ, 2, x
3	a_b%c*d?e[f]!	3a_b%c*d?e[f]	a_b%c*d?e[f]3-	a_b%c*d?e[f], 3, x
4	!	4	4-	, 4, x
5	NULL	NULL	5-	5, x
6	it's "quoted"!	6it's "quoted"	it's "quoted"6-	it's "quoted", 6, x
7	  padded  !	7  padded  	  padded  7-	  padded  , 7, x

query IIII
SELECT i, concat(NULL, NULL), concat_ws(NULL, s), s || NULL FROM {db}.t WHERE i = 1
----
1	(empty)	NULL	NULL

query III
SELECT i, (i > 2) || '', concat(i > 2) FROM {db}.t ORDER BY i
----
1	false	false
2	false	false
3	true	true
4	true	true
5	true	true
6	true	true
7	true	true

# length
query IIIIII
SELECT i, length(s), len(s), char_length(s), strlen(s), octet_length(encode(s)) FROM {db}.t ORDER BY i
----
1	11	11	11	11	11
2	9	9	9	12	12
3	12	12	12	12	12
4	0	0	0	0	0
5	NULL	NULL	NULL	NULL	NULL
6	13	13	13	13	13
7	10	10	10	10	10

# case conversion is Unicode aware
query IIIII
SELECT i, lower(s), upper(s), lcase(nc), ucase(nc) FROM {db}.t ORDER BY i
----
1	hello world	HELLO WORLD	hello	HELLO
2	straße äé	STRAẞE ÄÉ	hello	HELLO
3	a_b%c*d?e[f]	A_B%C*D?E[F]	hello	HELLO
4	(empty)	(empty)	b	B
5	NULL	NULL	NULL	NULL
6	it's "quoted"	IT'S "QUOTED"	ab	AB
7	  padded  	  PADDED  	ab	AB

# trimming / replacing
query IIIIIII
SELECT i, trim(s), ltrim(s), rtrim(s), trim(s, ' d'), ltrim(s, 'Ha '), rtrim(s, 'd ') FROM {db}.t ORDER BY i
