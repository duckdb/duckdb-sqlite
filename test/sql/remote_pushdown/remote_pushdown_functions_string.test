2	straße ÄÉ	straße ÄÉ	straße ÄÉ	straße ÄÉ	straße ÄÉ	straße ÄÉ
3	a_b%c*d?e[f]	a_b%c*d?e[f]	a_b%c*d?e[f]	a_b%c*d?e[f]	_b%c*d?e[f]	a_b%c*d?e[f]
4	(empty)	(empty)	(empty)	(empty)	(empty)	(empty)
5	NULL	NULL	NULL	NULL	NULL	NULL
6	it's "quoted"	it's "quoted"	it's "quoted"	it's "quoted"	it's "quoted"	it's "quoted"
7	padded	padded  	  padded	padde	padded  	  padde

query IIII
SELECT i, replace(s, 'l', 'L'), replace(s, '', 'x'), replace(s, 'ß', 'ss') FROM {db}.t ORDER BY i
----
