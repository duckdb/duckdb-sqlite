query III
SELECT i, s ILIKE p, s NOT ILIKE p FROM {db}.t ORDER BY i
----
1	true	false
2	false	true
3	false	true
4	true	false
5	NULL	NULL
6	true	false
7	true	false

query I
SELECT i FROM {db}.t WHERE s GLOB '*o*' ORDER BY i
----
1
6

query I
SELECT i FROM {db}.t WHERE s GLOB '[a-h]*' ORDER BY i
----
