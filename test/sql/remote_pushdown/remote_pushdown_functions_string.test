# DuckDB's substring / left / right with negative offsets and lengths
query IIIIIII
SELECT i, substring(s, -3), substring(s, 0, 2), substring(s, 2, -1), substring(s, i), substring(s, -i, 2), substr(s, 3, i - 2) FROM {db}.t ORDER BY i
----
