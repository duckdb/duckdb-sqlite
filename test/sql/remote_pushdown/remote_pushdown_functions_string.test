4	(empty)	0	(empty)	(empty)
5	NULL	NULL	NULL	NULL
6	69742773202271756F74656422	104	aXQncyAicXVvdGVkIg==	it\x27s \x22quoted\x22
7	20207061646465642020	80	ICBwYWRkZWQgIA==	  padded  

endloop

# LIKE with a constant pattern is serialized as a (case sensitive) GLOB
query II
EXPLAIN SELECT i FROM s.t WHERE s LIKE 'a\_b%' ESCAPE '\'
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*\("s" GLOB 'a_b\*'\).*

query II
EXPLAIN SELECT i FROM s.t WHERE s LIKE '%*%'
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*\("s" GLOB '\*\[\*\]\*'\).*

# non-constant patterns, ILIKE and Unicode case conversion use the functions of the extension
query II
EXPLAIN SELECT s LIKE p, s ILIKE 'a%', lower(s) FROM s.t
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*duckdb_like\("s", "p"\).*duckdb_ilike\("s", 'a%'\).*duckdb_lower\("s"\).*

# columns with a collation are compared with the BINARY collation
query II
EXPLAIN SELECT nc FROM s.t ORDER BY nc
----
physical_plan	<REGEX>:(?s).*Sqlite Query.*"nc" COLLATE BINARY AS "nc".*

# padding with an empty string raises an error in both
foreach db l s

statement error
SELECT lpad(s, 20, '') FROM {db}.t ORDER BY i
----
Insufficient padding

endloop
