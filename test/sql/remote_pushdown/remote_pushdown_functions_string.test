2	 ÄÉ	s	s	traße ÄÉ	ÄÉ	(empty)
3	[f]	a	a	b%c*d?e[f]	[f	b
4	(empty)	(empty)	(empty)	(empty)	(empty)	(empty)
5	NULL	NULL	NULL	NULL	NULL	NULL
6	ed"	i	i	"quoted"	uo	's "
7	d  	 	 	ed  	ad	padde

