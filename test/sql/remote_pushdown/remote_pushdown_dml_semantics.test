# name: test/sql/remote_pushdown/remote_pushdown_dml_semantics.test
# description: Pushed down writes have the same effect as the statements executed in DuckDB
# group: [remote_pushdown]

require sqlite_scanner

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_dml_semantics_l.db' AS l (TYPE SQLITE)

statement ok
SET sqlite_enable_remote_pushdown = true

statement ok
ATTACH '{TEST_DIR}/remote_pushdown_dml_semantics_s.db' AS s (TYPE SQLITE)

foreach db l s

# values whose storage class does not match the type of their column raise an error, like the table scan raises it
statement ok
FROM sqlite_query({db}, 'CREATE TABLE mixed(id INTEGER PRIMARY KEY, i INTEGER, s TEXT, d REAL)')

statement ok
FROM sqlite_query({db}, 'CREATE INDEX mixed_i ON mixed(i)')

statement ok
FROM sqlite_query({db}, 'INSERT INTO mixed VALUES (1, 1, ''a'', 1.5), (2, 7, ''b'', 2), (3, ''n/a'', ''c'', 3), (4, 3, x''41'', ''x'')')

statement error
DELETE FROM {db}.mixed WHERE i > 5
----
column was declared as integer, found "n/a" of type "text" instead

statement error
UPDATE {db}.mixed SET d = 0 WHERE s > 'a'
----
column was declared as text, found "A" of type "blob" instead

statement error
UPDATE {db}.mixed SET i = d + 1 WHERE id = 4
----
expected float or integer

# the rows whose values are not read are not checked
statement ok
UPDATE {db}.mixed SET d = 0 WHERE s = 'z'

statement ok
DELETE FROM {db}.mixed WHERE i < 2

statement ok
UPDATE {db}.mixed SET d = d + 1 WHERE id = 2

statement ok
DELETE FROM {db}.mixed WHERE id = 2

query I
SELECT id FROM sqlite_query({db}, 'SELECT id FROM mixed ORDER BY id')
----
3
4

# the subqueries of an UPDATE see the table before the update
statement ok
FROM sqlite_query({db}, 'CREATE TABLE chain(id INTEGER PRIMARY KEY, x INTEGER)')

statement ok
INSERT INTO {db}.chain VALUES (1, 2), (2, 3), (3, 1)

statement ok
UPDATE {db}.chain SET x = (SELECT c.x FROM {db}.chain c WHERE c.id = chain.x)

query II
SELECT * FROM {db}.chain ORDER BY id
----
1	3
2	1
3	2

# SQLite databases only have the main schema
statement error
USE {db}; DROP TABLE nosuchschema.chain
----
schema "nosuchschema" does not exist

statement ok
USE {db}

statement ok
DROP TABLE IF EXISTS nosuchschema.chain

statement ok
ALTER TABLE IF EXISTS nosuchschema.chain ADD COLUMN y INTEGER

statement ok
USE memory

statement error
CREATE VIEW {db}.nosuchschema.v AS SELECT 42
----
SQLite databases only have a single schema

query II
SELECT * FROM {db}.chain ORDER BY id
----
1	3
2	1
3	2

# a NOCASE key finds conflicts that DuckDB does not
statement ok
FROM sqlite_query({db}, 'CREATE TABLE nocase(s TEXT COLLATE NOCASE PRIMARY KEY, v INTEGER)')

statement ok
INSERT INTO {db}.nocase VALUES ('a', 1)

statement error
INSERT INTO {db}.nocase VALUES ('A', 2) ON CONFLICT (s) DO UPDATE SET v = excluded.v
----
UNIQUE constraint failed

query II
SELECT * FROM {db}.nocase
----
a	1

# the query of a view is bound
statement error
CREATE VIEW {db}.v AS SELECT nosuchcolumn FROM {db}.chain
----
Referenced column "nosuchcolumn" not found

query I
SELECT count(*) FROM duckdb_views() WHERE database_name = '{db}'
----
0

endloop

# the columns RETURNING reads are checked as well
statement error
DELETE FROM s.mixed WHERE id = 4 RETURNING *
----
column was declared as text, found "A" of type "blob" instead

query I
DELETE FROM s.mixed WHERE id = 4 RETURNING id
----
4
